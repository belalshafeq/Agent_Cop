# ============================================================
# AgentTrafficCop — .gitignore
# ============================================================

# --- Secrets & environment ---
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
ENV/
env/
.python-version

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# --- Type checkers / linters ---
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# --- IDE / editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs & runtime ---
*.log
logs/
*.pid
*.seed
*.pid.lock

# --- Build artifacts ---
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# AgentTrafficCop runtime files
audit.log
audit.log.*
*.audit.log