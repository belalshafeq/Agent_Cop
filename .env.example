# ============================================================
# AgentTrafficCop — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env` to git. It is gitignored for a reason.
# ============================================================

# --- Server ---
ATC_HOST=0.0.0.0
ATC_PORT=8000
ATC_LOG_LEVEL=INFO
ATC_ENV=development

# --- Security ---
# Comma-separated list of valid API keys.
# Generate strong keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example output: 3xK9pQ2mN7vR8sT1uW4yZ6aB5cD0eF2gH
#
# Any key listed here is treated as the `team` tier (legacy default).
# Use the tier-specific variables below to assign a different tier to
# individual keys.
ATC_API_KEYS=change-me-please-generate-a-real-key

# --- Tier assignments (optional) ---
# Any key listed in ATC_API_KEYS defaults to `team` tier.
# To assign a specific tier to a key, list it under one of these:
# (If a key appears in multiple tiers, the most permissive wins.)
ATC_FREE_API_KEYS=
ATC_PRO_API_KEYS=
ATC_TEAM_API_KEYS=
ATC_ENTERPRISE_API_KEYS=

# --- Tier message limits (per calendar month) ---
# 0 means unlimited.
ATC_TIER_FREE_LIMIT=10000
ATC_TIER_PRO_LIMIT=250000
ATC_TIER_TEAM_LIMIT=2000000
ATC_TIER_ENTERPRISE_LIMIT=0

# --- Usage enforcement ---
# If true, requests are rejected with 429 TIER_LIMIT_EXCEEDED once a key
# exceeds its monthly tier limit. Set to false to run in track-only mode.
ATC_USAGE_ENFORCEMENT_ENABLED=true
# Redis key prefix for usage counters (independent of session prefix).
ATC_USAGE_KEY_PREFIX=atc:usage:

# --- Request limits ---
ATC_MAX_BODY_BYTES=1048576
ATC_RATE_LIMIT_PER_MINUTE=120

# --- Observability ---
ATC_METRICS_ENABLED=true
ATC_METRICS_PATH=/metrics

# --- Audit log ---
ATC_AUDIT_LOG_ENABLED=false
ATC_AUDIT_LOG_PATH=./audit.log

# --- Storage backend ---
# Leave unset for in-memory (single process, lost on restart).
# Set to a Redis URL for shared, persistent sessions and usage counters.
# ATC_REDIS_URL=redis://localhost:6379/0
# ATC_REDIS_TTL_SECONDS=86400
# ATC_REDIS_KEY_PREFIX=atc:

# In-memory session TTL. 0 disables expiry.
ATC_SESSION_TTL_SECONDS=0

# --- Governance thresholds ---
ATC_MAX_STEPS=25
ATC_MAX_REPEATED_HASHES=3
ATC_MAX_CYCLE_LENGTH=2
ATC_MAX_CYCLE_REPEATS=3
ATC_HISTORY_WINDOW=16
ATC_MAX_SESSIONS=10000