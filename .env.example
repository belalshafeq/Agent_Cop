# ============================================================
# AgentTrafficCop — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env` to git. It is gitignored for a reason.
# ============================================================

# --- Server ---
ATC_HOST=0.0.0.0
ATC_PORT=8000
ATC_LOG_LEVEL=INFO
ATC_ENV=development

# --- Database (CRITICAL FOR RENDER) ---
# On Render, set this to /data/agenttrafficcop.db (your mounted disk)
# ATC_DB_PATH=/data/agenttrafficcop.db

# --- Security ---
# Comma-separated list of valid API keys.
# Generate strong keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Any key listed here is treated as the `team` tier (legacy default).
# Use the tier-specific variables below to assign a different tier.
ATC_API_KEYS=change-me-please-generate-a-real-key

# --- JWT Auth (CRITICAL) ---
# FIX (#5): Placeholder is intentionally EMPTY so that if ATC_ENV is
# anything other than development/test/local, the app refuses to start
# until a real secret is provided. This prevents shipping a guessable
# JWT signing key to production.
#
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATC_JWT_SECRET=

# --- Admin API keys ---
# FIX (M1): Restrict /v1/sessions/* and /v1/admin/* to a specific list
# of keys. If left empty, any `team`-tier key can access admin endpoints
# (a warning is logged at startup).
ATC_ADMIN_API_KEYS=

# --- Proxy trust ---
# FIX (C5): Set to true ONLY when running behind a known proxy (nginx,
# Cloudflare, Render). When true, X-Forwarded-For is used for rate
# limiting. When false, only the direct peer IP is used, which prevents
# header spoofing by direct-connection clients.
ATC_TRUST_PROXY=false

# --- Lemon Squeezy Billing ---
# LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/...
# LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret

# --- Error Tracking ---
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# --- Tier assignments (optional) ---
ATC_FREE_API_KEYS=
ATC_PRO_API_KEYS=
ATC_TEAM_API_KEYS=

# --- Tier message limits (per calendar month) ---
# 0 means unlimited.
ATC_TIER_FREE_LIMIT=10000
ATC_TIER_PRO_LIMIT=250000
ATC_TIER_TEAM_LIMIT=2000000

# --- Tier agent limits ---
ATC_TIER_FREE_AGENTS=5
ATC_TIER_PRO_AGENTS=25
ATC_TIER_TEAM_AGENTS=100

# --- Tier rate limits (requests per minute) ---
ATC_TIER_FREE_RATE_LIMIT=60
ATC_TIER_PRO_RATE_LIMIT=120
ATC_TIER_TEAM_RATE_LIMIT=300

# --- Usage enforcement ---
ATC_USAGE_ENFORCEMENT_ENABLED=true
ATC_USAGE_KEY_PREFIX=atc:usage:

# --- Request limits ---
ATC_MAX_BODY_BYTES=1048576
ATC_RATE_LIMIT_PER_MINUTE=120

# --- Observability ---
ATC_METRICS_ENABLED=true
ATC_METRICS_PATH=/metrics

# --- Audit log ---
ATC_AUDIT_LOG_ENABLED=false
ATC_AUDIT_LOG_PATH=./audit.log

# --- Storage backend ---
# ATC_REDIS_URL=redis://localhost:6379/0
# ATC_REDIS_TTL_SECONDS=86400
# ATC_REDIS_KEY_PREFIX=atc:
ATC_SESSION_TTL_SECONDS=0

# --- Governance thresholds ---
ATC_MAX_STEPS=25
ATC_MAX_REPEATED_HASHES=3
ATC_MAX_CYCLE_LENGTH=2
ATC_MAX_CYCLE_REPEATS=3
ATC_HISTORY_WINDOW=16
ATC_MAX_SESSIONS=10000